# .gitignore for project-render

# Build directories
/src-example/
/build/_deps/*
/build/Debug/*

# Ignore all build directories (VS, CMake, Archicad, Max)
build/
build-*/
out/
bin/
.vs/
_deps/
_CPack_Packages/

# Ignore compiled binaries and installers
*.dll
*.exe
*.msi

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeFiles/**

# Visual Studio / MSBuild
.vs/
*.vcxproj.user
*.vcxproj.filters.user
*.suo
*.user
*.userosscache
*.ncb
*.sdf
*.opensdf
*.pdb
*.ilk

# Project build outputs / binaries
*.a
*.so
*.dylib
*.app
*.out
*.o
*.obj

# Logs and temporary files
*.log
*.tmp
*.temp
*.cache
*.txt

# IDEs and editors
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# vcpkg/build artifacts (if vendored under repos/)
repos/vcpkg/buildtrees/
repos/vcpkg/downloads/
repos/vcpkg/packages/*/build/

# Runtime-generated assets
assets/*.glb

# Proprietary SDKs
thirdparty/archicad-sdk/
thirdparty/sketchup_sdk/
# Add any other proprietary SDKs here

# Backup files
*~
*.bak
*.swp

# Python
venv/
__pycache__/

# Misc
*.zip
*.7z
*.tar
*.gz

# End of file
*.bin
*.tlog
