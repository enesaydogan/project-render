#include <windows.h>

101 DIALOGEX 0, 0, 228, 206
STYLE DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Background sync is inactive.", 1001, 8, 8, 210, 18
    PUSHBUTTON "Start Sync", 1002, 8, 30, 68, 14
    PUSHBUTTON "Start Full Resync", 1004, 80, 30, 68, 14
    PUSHBUTTON "Stop Sync", 1003, 152, 30, 68, 14
    LTEXT "Last startup: none.", 1005, 8, 50, 210, 126
    LTEXT "Once started, sync keeps running after you close this utility.", -1, 8, 180, 210, 16
END
